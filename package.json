{
  "name": "ai-video-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Local YouTube video studio: Bonsai 27B writes, ElevenLabs narrates, FLUX draws, HyperFrames renders.",
  "type": "module",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "start": "vite build && OPEN=1 node src/server/index.ts",
    "app": "vite build && node src/server/index.ts",
    "server": "node src/server/index.ts",
    "app:dev": "vite",
    "llm": "bash bin/start-llm.sh",
    "video": "node src/cli/video.ts",
    "topics": "node src/cli/topics.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p app"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "hyperframes": "latest",
    "typescript": "^5.9.0",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
