{
  "name": "ai-video-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Local YouTube video studio: Bonsai 27B writes, ElevenLabs narrates, FLUX draws, HyperFrames renders.",
  "type": "module",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "start": "vite build && OPEN=1 node src/server/index.ts",
    "app": "vite build && node src/server/index.ts",
    "server": "node src/server/index.ts",
    "app:dev": "vite",
    "llm": "bash bin/start-llm.sh",
    "video": "node src/cli/video.ts",
    "topics": "node src/cli/topics.ts",
    "upload": "node src/cli/upload.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p app"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "hyperframes": "latest",
    "shadcn": "^4.21.5",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.57.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-resizable-panels": "^4.14.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  }
}
